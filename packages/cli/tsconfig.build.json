{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "sourceMap": true,
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "customConditions": null
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
