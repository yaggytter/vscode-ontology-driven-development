{
  "name": "ontology-driven-development-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "compile": "npm run compile -w packages/vscode",
    "lint": "eslint packages",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "vitest run --coverage",
    "test:integration": "npm run test:integration -w packages/vscode",
    "validate:release": "npm run validate:release -w packages/vscode",
    "verify": "npm run lint && npm run typecheck && npm test && npm run validate:release",
    "package": "npm run package -w packages/vscode"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.16.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.1.4",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "brace-expansion@5": "5.0.12",
    "fast-uri@3": "3.1.9",
    "js-yaml@4": "4.3.2",
    "markdown-it@14": "14.3.3",
    "undici@7": "7.30.1"
  }
}
